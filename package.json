{
  "name": "stias-dh-ai-workshop-2026",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "predev": "npm run downloads",
    "build": "vite build",
    "prebuild": "npm run downloads",
    "postbuild": "node --import tsx scripts/check-data.ts && node scripts/smoke-test.mjs && node scripts/check-links.mjs && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "og": "node --import tsx scripts/generate-og.ts",
    "downloads": "node --import tsx scripts/generate-cfp-downloads.ts && node --import tsx scripts/generate-programme-ics.ts",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale",
    "prepare": "npm run messages && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:scripts",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "svelte-kit sync && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test --project=chromium --project=firefox-smoke --project=webkit-smoke",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "test:e2e:live": "playwright test --project=live-maps"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.3",
    "@inlang/plugin-message-format": "^4.5.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "ical.js": "^2.2.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@lucide/svelte": "^1.67.0",
    "maplibre-gl": "6.16.0",
    "marked": "^18.1.3"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "@tailwindcss/vite": {
      "vite": "$vite"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
