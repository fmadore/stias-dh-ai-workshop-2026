{
  "name": "stias-dh-ai-workshop-2026",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "predev": "npm run downloads",
    "build": "vite build",
    "prebuild": "npm run downloads",
    "postbuild": "tsx scripts/check-data.ts && node scripts/smoke-test.mjs && node scripts/check-links.mjs && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "downloads": "tsx scripts/generate-cfp-downloads.ts",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale",
    "prepare": "npm run messages",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "tsx --test tests/localized-paths.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@inlang/plugin-message-format": "^4.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@inlang/paraglide-js": "^2.23.0",
    "@lucide/svelte": "^1.28.0",
    "marked": "^18.0.7"
  },
  "type": "module",
  "overrides": {
    "@tailwindcss/vite": {
      "vite": "$vite"
    }
  }
}
